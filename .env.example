TELEGRAM_BOT_TOKEN=
# Необязательно. Пустое значение включает публичный режим.
ALLOWED_TELEGRAM_IDS=
BOT_STARTUP_DELAY_SECONDS=5
PYTHONUNBUFFERED=1

# Изолированный тест распознавания плана. AI_API_KEY хранить только как секрет.
AI_API_KEY=
AI_BASE_URL=https://taynik.store/v1
AI_MODEL=gpt-6-luna
AI_ENABLED=false
AI_TIMEOUT_SECONDS=180
AI_MAX_FILE_BYTES=10000000
AI_MAX_IMAGE_DIMENSION=2200
AI_MAX_REQUESTS_PER_HOUR=3
AI_MAX_CONCURRENT_REQUESTS=2
